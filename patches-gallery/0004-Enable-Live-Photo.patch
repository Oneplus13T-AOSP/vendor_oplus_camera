From dfb3e1db8d9dbb0938bdd36c9eba6d8d352ea5af Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Sun, 30 Aug 2026 00:02:22 +0900
Subject: [PATCH 4/4] Enable Live Photo

Signed-off-by: RobertGarciaa <chae0218@naver.com>
---
 smali/com/oplus/aiunit/vision/fdb.smali | 43 +++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/smali/com/oplus/aiunit/vision/fdb.smali b/smali/com/oplus/aiunit/vision/fdb.smali
index 833008c..50678b4 100644
--- a/smali/com/oplus/aiunit/vision/fdb.smali
+++ b/smali/com/oplus/aiunit/vision/fdb.smali
@@ -126,6 +126,49 @@
 
     invoke-static {p0, v0}, Lkotlin/jvm/internal/Intrinsics;->checkNotNullParameter(Ljava/lang/Object;Ljava/lang/String;)V
 
+    # Only override the existing Live Photo feature keys.
+
+    const-string v0, "feature_is_support_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_live_photo_enabled
+
+    const-string v0, "feature_is_support_olive_slide_play"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_live_photo_enabled
+
+    const-string v0, "feature_is_support_video_extract_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_live_photo_enabled
+
+    const-string v0, "feature_olive_slow_motion_recommend_popup_shown"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_live_photo_enabled
+
+    goto :cond_stock_config
+
+    :cond_live_photo_enabled
+    const/4 v0, 0x1
+
+    return v0
+
+    :cond_stock_config
+
     sget-object v0, Lcom/oplus/aiunit/vision/flb;->a:Lcom/coloros/gallery3d/app/App;
 
     const/4 v1, 0x0
-- 
2.55.0
