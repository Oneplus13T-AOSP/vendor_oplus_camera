# APS job parameters shared by the camera app and cameraserver.
type data_system_camera_rus, file_type, data_file_type, core_data_file_type;

allow opluscamera_app data_system_camera_rus:dir {
    read write create getattr setattr rename open add_name remove_name search rmdir
};
allow opluscamera_app data_system_camera_rus:file {
    read write create getattr setattr append unlink rename open
};

allow cameraserver data_system_camera_rus:dir { read open search };
allow cameraserver data_system_camera_rus:file { read getattr setattr open };

allow system_server data_system_camera_rus:dir create_dir_perms;
allow system_server data_system_camera_rus:file create_file_perms;

allow installd data_system_camera_rus:dir { read open search };
allow installd data_system_camera_rus:file { read open };
